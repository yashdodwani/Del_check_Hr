# Copy to <repo root>/.env (git-ignored) and fill in. Never commit real values.
# LLM for ambiguous intent + vision OCR fallback: Google Gemini (gemini-3.5-flash-lite)
GEMINI_API_KEY=
# Free-tier pacing (requests per minute; 0 = unlimited)
# GEMINI_RPM=14
# Optional vision model override
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Optional: cost assumptions for usage_report.md (USD per 1M tokens)
# GHOST_PRICE_IN=0.10
# GHOST_PRICE_OUT=0.40
