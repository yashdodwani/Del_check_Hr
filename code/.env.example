# Copy to <repo root>/.env (git-ignored) and fill in. Never commit real values.
# Default LLM provider for intent + vision fallback: Google Gemini (gemini-3.5-flash-lite)
GEMINI_API_KEY=
# Free-tier pacing for Gemini (requests per minute; 0 = unlimited)
# GEMINI_RPM=14
# Optional NVIDIA provider (GHOST_INTENT_PROVIDER=nvidia / GHOST_VISION_PROVIDER=nvidia)
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# GHOST_INTENT_PROVIDER=gemini
# GHOST_VISION_PROVIDER=gemini
# Optional: cost assumptions for usage_report.md (USD per 1M tokens)
# GHOST_PRICE_IN=0.10
# GHOST_PRICE_OUT=0.40
