# Copy to <repo root>/.env (git-ignored) and fill in. Never commit real values.
NVIDIA_API_KEY=
# Optional: OpenAI-compatible NVIDIA endpoint override
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Vision fallback for screenshots / scanned PDF pages uses NVIDIA_API_KEY with
# nvidia/nemotron-3-nano-omni-30b-a3b-reasoning by default; override only if needed:
# NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Optional: cost assumptions for usage_report.md (USD per 1M tokens)
# GHOST_PRICE_IN=0.10
# GHOST_PRICE_OUT=0.40
